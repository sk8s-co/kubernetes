+// boolParam checks multiple query param names, returning true if any parse to true.
+func boolParam(req *http.Request, names ...string) bool {
+	for _, name := range names {
+		if b, _ := strconv.ParseBool(req.FormValue(name)); b {
+			return true
+		}
+	}
+	return false
