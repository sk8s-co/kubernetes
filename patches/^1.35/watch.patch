+	if r.backoffManager == nil {
+		r.backoffManager = wait.NewExponentialBackoffManager(defaultBackoffInit, defaultBackoffMax, defaultBackoffReset, defaultBackoffFactor, defaultBackoffJitter, r.clock)
+		return
