+// EmptyWatchError is returned when the watch result channel is closed
+// without having sent any events, if backoffOnEmpty is enabled.
+type EmptyWatchError struct {
+	// Name of the Reflector
+	Name string
+}
+
+// Error implements the error interface
+func (e *EmptyWatchError) Error() string {
+	return fmt.Sprintf("empty watch: %s: Watch closed with no items received", e.Name)
+}
+
+func isEmptyWatchError(err error) bool {
+	var emptyErr *EmptyWatchError
+	return errors.As(err, &emptyErr)
